# QuantumShield AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=quantumshield
POSTGRES_PASSWORD=quantumshield_secret
POSTGRES_DB=quantumshield

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Security ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── LLM Provider ───────────────────────────────────────────
# Set to: openai | anthropic | google | none
# "none" = deterministic-only mode (all classical tests still run)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# ─── Lab Target ─────────────────────────────────────────────
LAB_TARGET_URL=http://vulnerable-app:8080
ALLOWED_HOSTS=vulnerable-app,localhost,127.0.0.1
ENVIRONMENT=lab

# ─── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
